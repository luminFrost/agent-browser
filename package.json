{
  "name": "agent-browser",
  "version": "0.1.0",
  "private": true,
  "description": "사람 창과 로그인을 공유하는 에이전트 전용 창을 세션마다 CDP로 여는 데스크톱 브라우저",
  "license": "UNLICENSED",
  "main": "dist/launcher/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "start": "npm run build && node dist/launcher/cli.js",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run && playwright test"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "chrome-devtools-mcp": "^1.13.0",
    "electron": "^45.3.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
