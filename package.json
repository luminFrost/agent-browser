{
  "name": "agent-browser",
  "version": "0.1.0",
  "private": true,
  "description": "사람 창과 로그인을 공유하는 에이전트 전용 창을 세션마다 CDP로 여는 데스크톱 브라우저",
  "license": "UNLICENSED",
  "main": "dist/launcher/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "start": "npm run build && node dist/launcher/cli.js",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run && playwright test",
    "dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && electron-builder --mac dmg --arm64",
    "test:dist": "npm run dist && playwright test -c playwright.dist.config.ts"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "chrome-devtools-mcp": "^1.13.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "productName": "Agent Browser",
  "build": {
    "appId": "local.agent-browser",
    "productName": "Agent Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/app/entry.js"
    },
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
