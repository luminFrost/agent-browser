#!/bin/sh
# Claude Code에 MCP 서버로 등록하는 붙이기 명령(spec-claude-attach, README).
#   claude mcp add agent-browser -- "/Applications/Agent Browser.app/Contents/Resources/agent-browser-mcp"
# 앱 실행 파일을 Node 모드로 돌려 dist/attach/cli.js를 실행한다. 시스템 Node가 필요 없다.
HERE="$(cd "$(dirname "$0")" && pwd)"
ELECTRON_RUN_AS_NODE=1 exec "$HERE/../MacOS/Agent Browser" "$HERE/app/dist/attach/cli.js" "$@"
